{
  "name": "@local/canvas-workbench",
  "version": "1.9.51",
  "private": true,
  "description": "本地生图工作台,零订阅费:开自己的 API 生图(任意 OpenAI 兼容接口,零订阅),画布排版+修图/擦除/去背景/OCR/转矢量,可编辑 PSD/AI 交付,Photoshop/Illustrator 图层级双向桥接",
  "scripts": {
    "check": "node ../tests/check-portability.mjs && node scripts/check-syntax.mjs && node scripts/check-generated-jsx.mjs && node scripts/check-adobe-bridge-jsx.mjs && node scripts/check-windows-compat.mjs && node scripts/build-client.mjs --check && node scripts/patch-vendor-excalidraw.mjs --check",
    "test": "node --test \"tests/unit/**/*.test.mjs\" \"tests/migration/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:integration": "node tests/integration/api-parity.mjs",
    "test:smoke": "node tests/smoke/ui-snapshot.mjs",
    "build": "node scripts/build-client.mjs",
    "install:adobe-bridge": "node scripts/install-adobe-bridge.mjs",
    "package:npm": "node scripts/prepare-npm-package.mjs",
    "patch:vendor": "node scripts/patch-vendor-excalidraw.mjs"
  },
  "type": "module",
  "os": [
    "darwin",
    "win32"
  ],
  "dshCanvasCompatibility": {
    "strategy": "capability-detection",
    "hardClientDependencies": [
      "slots"
    ],
    "optionalClientCapabilities": [
      "conversation.chat.turnTail",
      "conversation.input.dock",
      "shell.overlay",
      "dsh-codex",
      "image-engine-settings",
      "agent-scoped-imagegen-routing"
    ],
    "failurePolicy": "disable-subfeature-without-blocking-renderer"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-canvas",
    "canvas",
    "excalidraw",
    "infinite-canvas",
    "whiteboard",
    "designer",
    "design-tools",
    "image-editing",
    "image-generation",
    "remove-background",
    "erase",
    "ocr",
    "text-recognition",
    "vectorize",
    "psd",
    "psd-export",
    "photoshop",
    "illustrator",
    "adobe",
    "chatgpt",
    "material-library",
    "openai-compatible",
    "image-api",
    "local-design-workstation",
    "ai-image-generator"
  ],
  "dependencies": {
    "ag-psd": "^31.0.2"
  }
}
